{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/prototipo/index.html" },
    { "source": "/img/:caminho*", "destination": "/prototipo/img/:caminho*" },
    { "source": "/capa-link.jpg", "destination": "/prototipo/capa-link.jpg" }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] }
  ]
}
